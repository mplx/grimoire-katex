# pragma-jennifer-capability: exec

/**
 * The launcher: hand the request on stdin to `katex.run` and exit its status.
 * Everything else is in the module, where a test can reach it.
 * @module grimoirekatex
 * @author mplx <mplx@jennifer-lang.dev>
 * @license LGPL-3.0-only
 */
use io;
use strings;

import "../src/katex.j" as katex;

exit katex.run(strings.join(io.readLines(), "\n"));
